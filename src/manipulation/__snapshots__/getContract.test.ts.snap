// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`getContract given: a 2-level subclass of DomainEntity when: the contract is requested then: the json-schema output (2-level subclass form) matches snapshot 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "name": {
      "type": "string",
    },
    "shellPattern": {
      "type": "string",
    },
    "uuid": {
      "type": "string",
    },
  },
  "required": [
    "name",
    "shellPattern",
  ],
  "type": "object",
  "x-domain-object": {
    "kind": "entity",
    "name": "GreenSeaturtle",
    "primary": [
      "uuid",
    ],
  },
}
`;

exports[`getContract given: a DomainEntity whose static nested names a field its schema lacks when: the contract is requested then: it fails fast with a nested-key-absent-from-schema ConstraintError 1`] = `
"✋ ConstraintError: Rack.contract(): key 'board' is declared in \`static nested\` but absent from \`static schema\`. add 'board' to Rack's schema, or drop it from \`static nested\`

{
  "domainObject": "Rack",
  "declaredIn": "static nested",
  "key": "board"
}"
`;

exports[`getContract given: a DomainEntity with primary, unique, alias, and nested when: the contract is embedded as a field in a parent z.object then: the pragma survives on the nested field of the parent json-schema 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "surfboard": {
      "properties": {
        "rider": {
          "properties": {
            "name": {
              "type": "string",
            },
            "uuid": {
              "type": "string",
            },
          },
          "required": [
            "name",
          ],
          "type": "object",
        },
        "serialNumber": {
          "type": "string",
        },
        "uuid": {
          "type": "string",
        },
      },
      "required": [
        "serialNumber",
        "rider",
      ],
      "type": "object",
      "x-domain-object": {
        "alias": {
          "plural": "surfboards",
          "singular": "surfboard",
        },
        "kind": "entity",
        "name": "SeaturtleSurfboard",
        "nested": {
          "rider": "Seaturtle",
        },
        "primary": [
          "uuid",
        ],
        "unique": [
          "serialNumber",
        ],
      },
    },
  },
  "required": [
    "surfboard",
  ],
  "type": "object",
}
`;

