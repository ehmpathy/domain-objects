exports[`getContract given: a DomainObject that declares static nested atop a NON-object schema when: the contract is requested then: it fails fast with a requires-object-schema ConstraintError 1`] = `
"✋ ConstraintError: Chant.contract() requires an object schema (z.object); a contract coerces the wire payload into a Chant instance, and a domain object is a record of named props — a scalar or array schema carries none, so the construct would yield an instance of indexed characters rather than fail. declare Chant's schema as a z.object (wrap a scalar as z.object({ value: … }) if Chant genuinely models one)

{
  "domainObject": "Chant"
}"
`;

exports[`getContract given: a DomainObject whose schema is joi, not zod when: the contract is requested then: it fails fast with a ConstraintError 1`] = `
"✋ ConstraintError: JoiSandbar.contract() requires a zod schema; joi/yup cannot carry json-schema identity. keep .schema for validation, but .contract() needs zod

{
  "domainObject": "JoiSandbar"
}"
`;

exports[`getContract given: a DomainObject whose schema is yup, not zod when: the contract is requested then: it fails fast with a ConstraintError 1`] = `
"✋ ConstraintError: YupSandbar.contract() requires a zod schema; joi/yup cannot carry json-schema identity. keep .schema for validation, but .contract() needs zod

{
  "domainObject": "YupSandbar"
}"
`;

exports[`getContract given: a DomainObject whose static schema is a SCALAR, not an object when: the contract is requested then: it fails fast with a requires-object-schema ConstraintError 1`] = `
"✋ ConstraintError: Fin.contract() requires an object schema (z.object); a contract coerces the wire payload into a Fin instance, and a domain object is a record of named props — a scalar or array schema carries none, so the construct would yield an instance of indexed characters rather than fail. declare Fin's schema as a z.object (wrap a scalar as z.object({ value: … }) if Fin genuinely models one)

{
  "domainObject": "Fin"
}"
`;

exports[`getContract given: a DomainObject with no schema declared when: the contract is requested then: it fails fast with a ConstraintError 1`] = `
"✋ ConstraintError: Driftwood.contract() requires a static schema. either declare \`static schema\` (zod) on Driftwood to use .contract() — or, if this call is a SELF-REFERENCE from inside Driftwood's own \`static schema\` initializer (a tree-shaped dobj), the field is not assigned yet at that moment: defer it with \`z.lazy(() => Driftwood.contract())\`

{
  "domainObject": "Driftwood"
}"
`;

